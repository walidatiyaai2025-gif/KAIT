@using System.Globalization
@inject ShellText L
@inject IdentityText I
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var language = isRtl ? "ar" : "en";
    var isSetup = Context.Request.Path.StartsWithSegments("/setup");
    var isPermissions = Context.Request.Path.StartsWithSegments("/permissions");
    var isMetadata = Context.Request.Path.StartsWithSegments("/metadata");
    var isAuthProfiles = Context.Request.Path.StartsWithSegments("/auth-profiles");
    var isMojUat = Context.Request.Path.StartsWithSegments("/moj-uat");
    var isExecution = Context.Request.Path.StartsWithSegments("/execute");
    var isRequests = Context.Request.Path.StartsWithSegments("/requests");
    var isAudit = Context.Request.Path.StartsWithSegments("/audit");
    var isOperations = Context.Request.Path.StartsWithSegments("/operations");
    var isHome = !isPermissions && !isMetadata && !isAuthProfiles && !isMojUat && !isExecution && !isRequests && !isAudit && !isOperations;
}
<!doctype html>
<html lang="@language" dir="@direction" data-culture-name="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · GSIP</title>
    <link rel="stylesheet" href="~/css/gsip.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/setup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/permissions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/metadata.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/execution.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/p13.css" asp-append-version="true" />
</head>
<body class="gsip-body @direction @(isSetup ? "setup-active" : string.Empty)">
    <a class="skip-link" href="#main-content">@L["SkipToContent"]</a>
    <header class="topbar">
        <div class="brand-cluster"><div class="brand-mark" aria-hidden="true"><span>G</span></div><div><div class="brand-title">@L["ProductName"]</div><div class="brand-subtitle">@L["ProductNameEnglish"]</div></div></div>
        <div class="topbar-motto"><strong>@L["Motto"]</strong><span>@L["MottoEnglish"]</span></div>
        <div class="topbar-actions">
            <button class="language-switch" type="button" data-culture="@(isRtl ? "en" : "ar-KW")" aria-label="@L["SwitchLanguage"]">@(isRtl ? "EN" : "AR")</button>
            @if (!isSetup)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" action="/logout" class="logout-form">@Html.AntiForgeryToken()<button class="login-link" type="submit">@I["SignOut"]</button></form>
                }
                else
                {
                    <a class="login-link" href="/login?culture=@CultureInfo.CurrentUICulture.Name">@L["Login"]</a>
                }
            }
        </div>
    </header>
    @if (!isSetup)
    {
        <aside class="sidebar" aria-label="@L["PrimaryNavigation"]">
            <div class="sidebar-accent"></div>
            <nav>
                <a class="nav-item @(isHome ? "active" : string.Empty)" href="/?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">⌂</span><span>@L["Home"]</span></a>
                <a class="nav-item @(isMetadata ? "active" : string.Empty)" href="/metadata?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">◇</span><span>@L["Entities"]</span></a>
                <a class="nav-item @(isExecution ? "active" : string.Empty)" href="/execute?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">▦</span><span>@L["Services"]</span></a>
                <a class="nav-item @(isAuthProfiles ? "active" : string.Empty)" href="/auth-profiles?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">◆</span><span>@L["AuthProfiles"]</span></a>
                <a class="nav-item @(isMojUat ? "active" : string.Empty)" href="/moj-uat?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">⚡</span><span>MOJ UAT</span></a>
                <a class="nav-item @(isRequests ? "active" : string.Empty)" href="/requests?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">≡</span><span>@L["Requests"]</span></a>
                <a class="nav-item @(isAudit ? "active" : string.Empty)" href="/audit?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">◴</span><span>@L["Audit"]</span></a>
                <a class="nav-item @(isPermissions ? "active" : string.Empty)" href="/permissions?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">◈</span><span>@L["Permissions"]</span></a>
                <a class="nav-item @(isOperations ? "active" : string.Empty)" href="/operations?culture=@CultureInfo.CurrentUICulture.Name"><span class="nav-glyph">⚙</span><span>@L["Settings"]</span></a>
            </nav>
            <div class="sidebar-foot"><span class="phase-dot"></span><div><strong>P13</strong><small>@L["Home"]</small></div></div>
        </aside>
    }
    <main id="main-content" class="main-content @(isSetup ? "setup-main" : string.Empty)" tabindex="-1">@RenderBody()</main>
    <script src="~/js/language-switch.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
