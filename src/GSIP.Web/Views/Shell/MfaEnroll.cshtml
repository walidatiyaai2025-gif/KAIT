@model MfaEnrollmentViewModel
@inject IdentityText I
@{
    ViewData["Title"] = I["MfaEnrollTitle"];
}
<section class="login-stage auth-stage">
    <div class="login-intro">
        <span class="eyebrow">GSIP · P03</span>
        <h1>@I["MfaEnrollTitle"]</h1>
        <p>@I["MfaEnrollIntro"]</p>
    </div>
    <div class="login-card auth-card" data-auth-state="mfa-enrollment">
        <span class="auth-step">@I["ProtectedStep"]</span>
        <h2>@I["MfaEnrollTitle"]</h2>
        <p>@I["MfaEnrollIntro"]</p>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorCode))
        {
            <div class="auth-error" role="alert">@I[Model.ErrorCode]</div>
        }
        <div class="security-key">
            <span>@I["AuthenticatorKey"]</span>
            <code dir="ltr">@Model.SharedKey</code>
        </div>
        <form method="post" action="/mfa/enroll" autocomplete="off">
            @Html.AntiForgeryToken()
            <label asp-for="Code">@I["MfaCode"]</label>
            <div class="input-shell"><span aria-hidden="true">#</span><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" placeholder="@I["MfaCodePlaceholder"]" /></div>
            <button class="primary-button" type="submit">@I["ConfirmMfa"]</button>
        </form>
        <div class="phase-notice"><span>i</span><p>@I["SecureSessionNotice"]</p></div>
    </div>
</section>
