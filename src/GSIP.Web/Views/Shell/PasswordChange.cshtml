@model PasswordChangeViewModel
@inject IdentityText I
@{
    ViewData["Title"] = I["PasswordChangeTitle"];
}
<section class="login-stage auth-stage">
    <div class="login-intro">
        <span class="eyebrow">GSIP · P03</span>
        <h1>@I["PasswordChangeTitle"]</h1>
        <p>@I["PasswordChangeIntro"]</p>
    </div>
    <div class="login-card auth-card" data-auth-state="password-change">
        <span class="auth-step">@I["ProtectedStep"]</span>
        <h2>@I["PasswordChangeTitle"]</h2>
        <p>@I["PasswordChangeIntro"]</p>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorCode))
        {
            <div class="auth-error" role="alert">@I[Model.ErrorCode]</div>
        }
        <form method="post" action="/password/change" autocomplete="off">
            @Html.AntiForgeryToken()
            <label asp-for="CurrentPassword">@I["CurrentPassword"]</label>
            <div class="input-shell"><span aria-hidden="true">◇</span><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /></div>
            <label asp-for="NewPassword">@I["NewPassword"]</label>
            <div class="input-shell"><span aria-hidden="true">＋</span><input asp-for="NewPassword" type="password" autocomplete="new-password" /></div>
            <label asp-for="ConfirmPassword">@I["ConfirmPassword"]</label>
            <div class="input-shell"><span aria-hidden="true">✓</span><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></div>
            <button class="primary-button" type="submit">@I["ChangePassword"]</button>
        </form>
        <div class="phase-notice"><span>i</span><p>@I["SecureSessionNotice"]</p></div>
    </div>
</section>
