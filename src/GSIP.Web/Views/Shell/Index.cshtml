@using System.Globalization
@model ShellViewModel
@{
    var isArabic = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    Func<string, string, string> t = (en, ar) => isArabic ? ar : en;
    ViewData["Title"] = t("Government Services Dashboard", "لوحة الخدمات الحكومية");
}
<section class="hero-row p13-dashboard-hero" data-testid="p13-home-dashboard" data-phase="@Model.Phase">
    <div>
        <span class="eyebrow">GSIP · @Model.Phase</span>
        <h1>@t("Integrated Government Services Portal", "بوابة تكامل الخدمات الحكومية")</h1>
        <p>@t("Browse the active service catalogue and continue to governed execution, request history, permissions and audit workspaces.", "استعرض كتالوج الخدمات النشطة وانتقل إلى مساحات التنفيذ المحكوم وسجل الطلبات والصلاحيات والتدقيق.")</p>
    </div>
    <a class="dashboard-primary-link" href="/execute?culture=@CultureInfo.CurrentUICulture.Name">@t("Open Service Execution", "فتح تنفيذ الخدمات")</a>
</section>

<section class="kpi-grid" aria-label="@t("Live catalogue summary", "ملخص الكتالوج الحالي")">
    <article class="kpi-card"><span class="kpi-icon blue" aria-hidden="true">◇</span><div><strong>@Model.ActiveEntityCount</strong><span>@t("Active entities", "الجهات النشطة")</span></div></article>
    <article class="kpi-card"><span class="kpi-icon teal" aria-hidden="true">▦</span><div><strong>@Model.ActiveServiceCount</strong><span>@t("Active services", "الخدمات النشطة")</span></div></article>
    <article class="kpi-card"><span class="kpi-icon gold" aria-hidden="true">◎</span><div><strong>@Model.ActiveEnvironmentCount</strong><span>@t("Active environments", "البيئات النشطة")</span></div></article>
    <article class="kpi-card"><span class="kpi-icon navy" aria-hidden="true">#</span><div><strong>v@Model.ProductVersion</strong><span>@t("Build version", "إصدار التطبيق")</span></div></article>
</section>

<form class="dashboard-filter" method="get" action="/" role="search" aria-label="@t("Service catalogue filters", "مرشحات كتالوج الخدمات")">
    <div>
        <label for="dashboard-entity">@t("Government entity", "الجهة الحكومية")</label>
        <select id="dashboard-entity" name="entityCode">
            <option value="">@t("All active entities", "كل الجهات النشطة")</option>
            @foreach (var entity in Model.Entities)
            {
                <option value="@entity.Code" selected="@(string.Equals(Model.SelectedEntityCode, entity.Code, StringComparison.OrdinalIgnoreCase))">@(isArabic ? entity.NameAr : entity.NameEn) · @entity.Code</option>
            }
        </select>
    </div>
    <div class="dashboard-search-field">
        <label for="dashboard-search">@t("Search services", "بحث الخدمات")</label>
        <input id="dashboard-search" type="search" name="search" maxlength="120" value="@Model.Search" placeholder="@t("Service or entity name/code", "اسم أو رمز الخدمة أو الجهة")" />
    </div>
    <button class="dashboard-filter-button" type="submit">@t("Apply", "تطبيق")</button>
    @if (!string.IsNullOrWhiteSpace(Model.SelectedEntityCode) || !string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="dashboard-clear-link" href="/?culture=@CultureInfo.CurrentUICulture.Name">@t("Clear filters", "مسح المرشحات")</a>
    }
</form>

<section class="dashboard-services" aria-labelledby="available-services-title">
    <div class="section-heading">
        <div>
            <h2 id="available-services-title">@t("Available Services", "الخدمات المتاحة")</h2>
            <p>@t("Only active current catalogue definitions are shown. Execution permissions are enforced independently on the execution screen.", "تظهر تعريفات الكتالوج الحالية والنشطة فقط. يتم فرض صلاحيات التنفيذ بشكل مستقل في شاشة التنفيذ.")</p>
        </div>
        <span class="preview-chip">@Model.Services.Count @t("shown", "معروضة")</span>
    </div>

    @if (Model.Services.Count == 0)
    {
        <div class="dashboard-empty" role="status">@t("No active services match the current filters.", "لا توجد خدمات نشطة تطابق المرشحات الحالية.")</div>
    }
    else
    {
        <div class="dashboard-table-wrap">
            <table class="dashboard-service-table">
                <caption class="visually-hidden">@t("Active government service catalogue", "كتالوج الخدمات الحكومية النشطة")</caption>
                <thead>
                    <tr>
                        <th scope="col">@t("Entity", "الجهة")</th>
                        <th scope="col">@t("Service", "الخدمة")</th>
                        <th scope="col">@t("Version", "الإصدار")</th>
                        <th scope="col">@t("Environments", "البيئات")</th>
                        <th scope="col">@t("Status", "الحالة")</th>
                        <th scope="col">@t("Action", "الإجراء")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var service in Model.Services)
                {
                    <tr data-testid="dashboard-service-row" data-entity-code="@service.EntityCode" data-service-code="@service.ServiceCode">
                        <td><strong>@(isArabic ? service.EntityNameAr : service.EntityNameEn)</strong><small dir="ltr">@service.EntityCode</small></td>
                        <td><strong>@(isArabic ? service.ServiceNameAr : service.ServiceNameEn)</strong><small>@(isArabic ? service.DescriptionAr : service.DescriptionEn)</small><code dir="ltr">@service.ServiceCode</code></td>
                        <td dir="ltr">v@service.Version</td>
                        <td>@service.ActiveEnvironmentCount</td>
                        <td><span class="status-badge"><i></i>@t("Active", "نشطة")</span></td>
                        <td><a class="dashboard-service-link" href="/execute?entityId=@service.EntityId&serviceId=@service.ServiceId&culture=@CultureInfo.CurrentUICulture.Name">@t("Open", "فتح")</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<aside class="dashboard-assurance" aria-label="@t("Dashboard data boundary", "حدود بيانات لوحة المعلومات")">
    <span aria-hidden="true">i</span>
    <p>@t("Dashboard counts come from the non-secret metadata catalogue. Request and audit totals remain inside their separately authorized workspaces rather than being exposed here.", "تأتي أرقام لوحة المعلومات من كتالوج البيانات الوصفية غير السري. تبقى إجماليات الطلبات والتدقيق داخل مساحات العمل ذات الصلاحيات المنفصلة ولا يتم كشفها هنا.")</p>
</aside>

<footer class="shell-footer">@t("Rendered", "وقت العرض") @Model.GeneratedAtUtc.ToString("u", CultureInfo.InvariantCulture)</footer>
