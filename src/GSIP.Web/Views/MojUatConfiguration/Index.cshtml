@using System.Globalization
@model GSIP.Web.Models.MojUatConfigurationViewModel
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = isRtl ? "إعداد اختبار وزارة العدل" : "MOJ UAT Configuration";
    var serviceName = isRtl ? Model.ServiceNameAr : Model.ServiceNameEn;
}
<link rel="stylesheet" href="~/css/auth-profiles.css" asp-append-version="true" />

<section class="auth-admin" aria-labelledby="moj-uat-title">
    <header class="auth-hero">
        <div>
            <span class="auth-kicker">MOJ · UAT · API 129 · TOKEN FLOW</span>
            <h1 id="moj-uat-title">@(isRtl ? "إعداد اختبار خدمة حالات الزواج" : "Marriage Cases UAT setup")</h1>
            <p>@(isRtl ? "أدخل x-api-key واسم المستخدم وكلمة المرور الخاصة ببيئة UAT. النظام يستدعي /genToken أولًا ثم يستخدم Bearer Token الناتج مع نفس API Key لتنفيذ الخدمة." : "Enter the UAT x-api-key, username and password. GSIP calls /genToken first, then uses the acquired Bearer token with the same API key to execute the service.")</p>
        </div>
        <div class="auth-security-note" role="note">
            <span aria-hidden="true">●</span>
            <strong>@(Model.ReadyToExecute ? (isRtl ? "جاهز للتجربة" : "Ready to test") : (isRtl ? "يحتاج إعداد" : "Setup required"))</strong>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-alert error" role="alert">
            @switch (Model.ErrorMessage)
            {
                case "INVALID_API_KEY":
                    <span>@(isRtl ? "أدخل API Key صالحًا (8 أحرف على الأقل) بدون أسطر جديدة." : "Enter a valid API key (minimum 8 characters) without line breaks.")</span>
                    break;
                case "INVALID_USERNAME":
                    <span>@(isRtl ? "أدخل اسم المستخدم الرسمي لبيئة UAT." : "Enter the official UAT username.")</span>
                    break;
                case "INVALID_PASSWORD":
                    <span>@(isRtl ? "أدخل كلمة المرور الرسمية لبيئة UAT." : "Enter the official UAT password.")</span>
                    break;
                case "INCOMPATIBLE_SECRET_SLOTS":
                    <span>@(isRtl ? "الـ AuthProfile يحتوي بيانات اعتماد غير متوافقة. تم إيقاف التحويل لحماية البيانات؛ راجع Authentication Profiles أولًا." : "The AuthProfile contains incompatible credential slots. Conversion stopped safely; review Authentication Profiles first.")</span>
                    break;
                default:
                    <span>@(isRtl ? "فشل إعداد Token Flow بصورة آمنة. ظل الـ AuthProfile غير مفعّل." : "Token-flow configuration failed safely. The AuthProfile remains disabled.")</span>
                    break;
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="auth-alert success" role="status">
            @(Model.SuccessMessage == "UAT_DISABLED"
                ? (isRtl ? "تم إيقاف UAT." : "UAT was disabled.")
                : (isRtl ? "تم حفظ بيانات الاعتماد وتفعيل Token Flow لـ UAT بنجاح." : "The credentials were stored securely and the UAT token flow was enabled successfully."))
        </div>
    }

    <div class="auth-stat-grid" aria-label="@(isRtl ? "حالة UAT" : "UAT status")">
        <article><strong>@(Model.ConfigurationActive ? "ON" : "OFF")</strong><span>UAT</span></article>
        <article><strong>@Model.AuthenticationType</strong><span>@(isRtl ? "نوع المصادقة" : "Authentication")</span></article>
        <article><strong>@(Model.ApiKeyConfigured ? "READY" : "MISSING")</strong><span>x-api-key</span></article>
        <article><strong>@Model.Status</strong><span>@(isRtl ? "الحالة" : "Status")</span></article>
    </div>

    <div class="auth-workspace">
        <section class="auth-panel create-panel" aria-labelledby="api129-config-title">
            <div class="panel-heading">
                <div>
                    <h2 id="api129-config-title">@serviceName</h2>
                    <p><code>@Model.ServiceCode</code></p>
                </div>
                <span class="isolation-badge isolated">UAT</span>
            </div>

            <div class="binding-ledger">
                <div class="binding-chip"><strong>Base URL</strong><code>@Model.BaseUrl</code></div>
                <div class="binding-chip"><strong>Token</strong><code>/genToken</code></div>
                <div class="binding-chip"><strong>Service Path</strong><code>@Model.RelativePath</code></div>
                <div class="binding-chip"><strong>Method</strong><code>@Model.HttpMethod</code></div>
            </div>

            <form method="post" action="/moj-uat/api129/configure" class="auth-form" autocomplete="off">
                @Html.AntiForgeryToken()
                <label>
                    x-api-key
                    <input name="apiKey" type="password" required minlength="8" maxlength="4096" autocomplete="new-password" spellcheck="false" />
                </label>
                <label>
                    Username
                    <input name="username" type="text" required maxlength="4096" autocomplete="off" spellcheck="false" />
                </label>
                <label>
                    Password
                    <input name="password" type="password" required maxlength="4096" autocomplete="new-password" spellcheck="false" />
                </label>
                <small>@(isRtl ? "القيم Write-only ولا يعاد عرضها. عقد API129 المثبّت يتطلب x-api-key وusername وpassword عند /genToken؛ لا يتم إنشاء قيم فارغة أو افتراض بيانات Production." : "All values are write-only and never redisplayed. The proven API129 contract requires x-api-key, username and password for /genToken; GSIP does not synthesize empty credentials or infer Production settings.")</small>
                <button class="auth-button" type="submit">@(isRtl ? "حفظ بيانات الاعتماد وتفعيل Token Flow" : "Save credentials and enable token flow")</button>
            </form>

            @if (Model.ReadyToExecute)
            {
                <p>
                    <a class="auth-button secondary" href="/execute?entityId=@Model.EntityId&serviceId=@Model.ServiceId&environmentId=@Model.EnvironmentId">
                        @(isRtl ? "فتح تجربة الخدمة" : "Open service test")
                    </a>
                </p>
            }
        </section>

        <section class="auth-panel hierarchy-panel" aria-labelledby="uat-safety-title">
            <div class="panel-heading">
                <div>
                    <h2 id="uat-safety-title">@(isRtl ? "تسلسل المصادقة" : "Authentication sequence")</h2>
                    <p>@(isRtl ? "الـ Bearer Token لا يُدخل يدويًا ولا يُعرض للمستخدم." : "The Bearer token is never entered manually or redisplayed to the user.")</p>
                </div>
            </div>
            <div class="entity-stack">
                <article class="hierarchy-entity">
                    <header><span class="entity-code">1</span><h3>POST /genToken</h3></header>
                    <p>@(isRtl ? "يرسل x-api-key مع username وpassword الخاصة ببيئة UAT كما هو مثبت في عقد الخدمة." : "Sends x-api-key with the UAT username and password exactly as required by the proven service contract.")</p>
                </article>
                <article class="hierarchy-entity">
                    <header><span class="entity-code">2</span><h3>Bearer Token</h3></header>
                    <p>@(isRtl ? "يقرأ النظام التوكن من حقل data ويحتفظ به داخل runtime/token cache فقط." : "GSIP reads the token from the data field and keeps it only inside the runtime/token cache.")</p>
                </article>
                <article class="hierarchy-entity">
                    <header><span class="entity-code">3</span><h3>POST @Model.RelativePath</h3></header>
                    <p>@(isRtl ? "ينفذ الطلب باستخدام Authorization: Bearer مع نفس x-api-key وبيانات الخدمة مثل civilId." : "Executes the service using Authorization: Bearer, the same x-api-key, and the service input such as civilId.")</p>
                </article>
                <article class="hierarchy-entity">
                    <header><span class="entity-code">PROD</span><h3>@(isRtl ? "معزول" : "Isolated")</h3></header>
                    <p>@(isRtl ? "Production لا يتم تخمين رابطه أو بياناته أو نسخ UAT إليه. يبقى غير مفعّل حتى وصول العقد الرسمي الخاص به." : "Production URL and credentials are never inferred or copied from UAT. It remains disabled until its own official contract is supplied.")</p>
                </article>
            </div>

            <form method="post" action="/moj-uat/api129/disable" class="auth-form">
                @Html.AntiForgeryToken()
                <button class="auth-button danger-outline" type="submit">@(isRtl ? "إيقاف UAT" : "Disable UAT")</button>
            </form>
        </section>
    </div>
</section>
