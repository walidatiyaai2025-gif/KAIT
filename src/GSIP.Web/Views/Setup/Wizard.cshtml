@using System.Globalization
@using GSIP.Application.Setup
@model SetupWizardViewModel
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    Func<string, string, string> t = (en, ar) => isArabic ? ar : en;
    ViewData["Title"] = t("First-run Setup", "إعداد النظام لأول مرة");
    var backStep = Model.Step > SetupStep.Welcome ? (SetupStep)((int)Model.Step - 1) : SetupStep.Welcome;
}

<section class="setup-shell" data-setup-step="@Model.Step" data-setup-culture="@Model.Culture">
    <header class="setup-header">
        <div>
            <span class="status-badge">@t("First-run configuration", "إعداد التشغيل الأول")</span>
            <h1>@t("GSIP Setup Wizard", "معالج إعداد بوابة GSIP")</h1>
            <p>@t("Complete the protected setup before normal sign-in becomes available.", "أكمل الإعداد الآمن قبل إتاحة تسجيل الدخول العادي.")</p>
        </div>
        <div class="setup-progress-copy">@Model.ProgressPercent%</div>
    </header>

    <div class="setup-progress"><span style="width:@Model.ProgressPercent%"></span></div>

    <ol class="setup-steps" aria-label="Setup progress">
        @foreach (var step in Enum.GetValues<SetupStep>())
        {
            var state = step == Model.Step ? "current" : ((int)step < (int)Model.Step ? "done" : "pending");
            <li class="@state"><span>@((int)step + 1)</span><small>@step</small></li>
        }
    </ol>

    @if (Model.Operation is not null)
    {
        <div class="setup-message @(Model.Operation.Success ? "success" : "error")" role="status" data-operation-code="@Model.Operation.Code">
            <strong>@(Model.Operation.Success ? t("Passed", "ناجح") : t("Action required", "مطلوب إجراء"))</strong>
            <span>@Model.Operation.Message</span>
        </div>
    }

    <div class="setup-card">
        @switch (Model.Step)
        {
            case SetupStep.Welcome:
                <h2>@t("Welcome", "مرحباً")</h2>
                <p>@t("Choose the setup language. You can change the application language later.", "اختر لغة الإعداد. يمكنك تغيير لغة التطبيق لاحقاً.")</p>
                <form asp-action="Welcome" method="post" class="setup-form">
                    @Html.AntiForgeryToken()
                    <label>@t("Language", "اللغة")</label>
                    <select name="culture" class="input-shell">
                        <option value="en" selected="@(Model.Draft.Culture == "en")">English</option>
                        <option value="ar-KW" selected="@(Model.Draft.Culture == "ar-KW")">العربية</option>
                    </select>
                    <div class="setup-actions"><button class="button-primary" type="submit">@t("Next", "التالي")</button></div>
                </form>
                break;

            case SetupStep.Preflight:
                <h2>@t("Preflight checks", "فحوصات ما قبل الإعداد")</h2>
                <p>@t("The wizard validates secure local storage and Data Protection before database configuration.", "يتحقق المعالج من التخزين المحلي الآمن وحماية البيانات قبل إعداد قاعدة البيانات.")</p>
                <ul class="setup-checks">
                    @foreach (var check in Model.PreflightChecks) { <li>@check</li> }
                </ul>
                <form asp-action="Preflight" method="post">@Html.AntiForgeryToken()<div class="setup-actions"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Run checks & Next", "تشغيل الفحوصات والمتابعة")</button></div></form>
                break;

            case SetupStep.Database:
                <h2>@t("SQL Server", "قاعدة بيانات SQL Server")</h2>
                <p>@t("Choose the authentication mode explicitly. Windows Authentication uses the Windows identity running GSIP and ignores SQL username/password. SQL Authentication uses the supplied SQL login and never falls back to Windows Authentication. Credentials are never logged and setup state is Data Protection encrypted.", "اختر طريقة الدخول بشكل صريح. Windows Authentication يستخدم هوية Windows التي تشغل GSIP ويتجاهل اسم المستخدم وكلمة مرور SQL. SQL Authentication يستخدم اعتماد SQL المُدخل ولا يتحول تلقائياً إلى Windows Authentication. لا يتم تسجيل بيانات الاعتماد ويتم تشفير حالة الإعداد بواسطة Data Protection.")</p>
                <form asp-action="Database" method="post" class="setup-form two-column">
                    @Html.AntiForgeryToken()
                    <div><label>@t("Server / Instance / TCP endpoint", "الخادم / Instance / عنوان TCP")</label><input class="input-shell" name="Server" value="@Model.Draft.Database.Server" required autocomplete="off" /><small class="form-hint">@t("Examples: SERVER\\INSTANCE or tcp:172.30.88.33,1433. Use a comma before an explicit SQL Server TCP port.", "أمثلة: SERVER\\INSTANCE أو tcp:172.30.88.33,1433. استخدم فاصلة قبل منفذ TCP الصريح لـ SQL Server.")</small></div>
                    <div><label>@t("Database name", "اسم قاعدة البيانات")</label><input class="input-shell" name="DatabaseName" value="@Model.Draft.Database.DatabaseName" required pattern="[A-Za-z0-9_]+" /></div>
                    <div><label>@t("Authentication mode", "طريقة الدخول")</label><select class="input-shell" name="authenticationMode" required><option value="windows" selected="@Model.Draft.Database.UseWindowsAuthentication">Windows Authentication — GSIP process identity</option><option value="sql" selected="@(!Model.Draft.Database.UseWindowsAuthentication)">SQL Authentication — username + password</option></select></div>
                    <div><label>@t("SQL username (SQL Authentication only)", "اسم مستخدم SQL (لـ SQL Authentication فقط)")</label><input class="input-shell" name="Username" value="@Model.Draft.Database.Username" autocomplete="off" /></div>
                    <div><label>@t("SQL password (SQL Authentication only)", "كلمة مرور SQL (لـ SQL Authentication فقط)")</label><input class="input-shell" type="password" name="Password" value="" autocomplete="new-password" /></div>
                    <div><label>@t("Connection timeout (seconds)", "مهلة الاتصال بالثواني")</label><input class="input-shell" type="number" min="3" max="120" name="TimeoutSeconds" value="@Model.Draft.Database.TimeoutSeconds" /></div>
                    <label class="check-row"><input type="hidden" name="Encrypt" value="false" /><input type="checkbox" name="Encrypt" value="true" checked="@Model.Draft.Database.Encrypt" /> @t("Encrypt connection", "تشفير الاتصال")</label>
                    <label class="check-row"><input type="hidden" name="TrustServerCertificate" value="false" /><input type="checkbox" name="TrustServerCertificate" value="true" checked="@Model.Draft.Database.TrustServerCertificate" /> @t("Trust server certificate (only when explicitly approved; GSIP never enables this automatically)", "الوثوق بشهادة الخادم فقط عند الاعتماد الصريح؛ لا يقوم GSIP بتفعيل ذلك تلقائياً")</label>
                    <label class="check-row"><input type="hidden" name="CreateDatabase" value="false" /><input type="checkbox" name="CreateDatabase" value="true" checked="@Model.Draft.Database.CreateDatabase" /> @t("Create database if missing", "إنشاء قاعدة البيانات إذا لم تكن موجودة")</label>
                    <p class="full form-hint">@t("Test Connection always authenticates to the master database first, matching the setup/provisioning boundary.", "اختبار الاتصال يبدأ دائماً بالمصادقة على قاعدة master بما يتوافق مع مسار الإعداد والتجهيز.")</p>
                    <div class="setup-actions full"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-secondary" name="command" value="test" type="submit">@t("Test Connection", "اختبار الاتصال")</button><button class="button-primary" name="command" value="next" type="submit">@t("Test & Next", "اختبار والمتابعة")</button></div>
                </form>
                break;

            case SetupStep.Provision:
                <h2>@t("Database provisioning", "تجهيز قاعدة البيانات")</h2>
                <p>@t("GSIP will create or use the selected database and apply EF Core migrations. This operation is retry-safe.", "سيقوم GSIP بإنشاء أو استخدام قاعدة البيانات المحددة وتطبيق EF Core migrations. يمكن إعادة المحاولة بأمان.")</p>
                <div class="review-grid"><div><span>@t("Server", "الخادم")</span><strong>@Model.Draft.Database.Server</strong></div><div><span>@t("Database", "قاعدة البيانات")</span><strong>@Model.Draft.Database.DatabaseName</strong></div><div><span>@t("Connection test", "اختبار الاتصال")</span><strong>@(Model.Draft.DatabaseConnectionVerified ? "PASS" : "REQUIRED")</strong></div></div>
                <form asp-action="Provision" method="post">@Html.AntiForgeryToken()<div class="setup-actions"><a class="button-secondary" href="@Url.Action("Index", new { step = SetupStep.Database, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Provision / Migrate", "تجهيز / ترقية قاعدة البيانات")</button></div></form>
                break;

            case SetupStep.Administrator:
                <h2>@t("Initial System Administrator", "مدير النظام الأول")</h2>
                <p>@t("A bootstrap administrator credential is stored as a one-way password hash and is handed to the Identity phase for account activation.", "يُحفظ اعتماد المدير الأول كـ password hash أحادي الاتجاه ليتم تفعيله ضمن مرحلة الهوية.")</p>
                <form asp-action="Administrator" method="post" class="setup-form two-column">
                    @Html.AntiForgeryToken()
                    <div><label>@t("Display name", "الاسم")</label><input class="input-shell" name="DisplayName" value="@Model.Draft.Administrator.DisplayName" required /></div>
                    <div><label>@t("Username", "اسم المستخدم")</label><input class="input-shell" name="Username" value="@Model.Draft.Administrator.Username" required autocomplete="off" /></div>
                    <div class="full"><label>@t("Email", "البريد الإلكتروني")</label><input class="input-shell" type="email" name="Email" value="@Model.Draft.Administrator.Email" required /></div>
                    <div><label>@t("Password", "كلمة المرور")</label><input class="input-shell" type="password" name="Password" required minlength="12" autocomplete="new-password" /></div>
                    <div><label>@t("Confirm password", "تأكيد كلمة المرور")</label><input class="input-shell" type="password" name="confirmPassword" required minlength="12" autocomplete="new-password" /></div>
                    <p class="full form-hint">@t("Minimum 12 characters with uppercase, lowercase, number and symbol.", "12 حرفاً على الأقل مع حرف كبير وصغير ورقم ورمز.")</p>
                    <div class="setup-actions full"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Next", "التالي")</button></div>
                </form>
                break;

            case SetupStep.Branding:
                <h2>@t("Organization & branding", "الجهة والهوية البصرية")</h2>
                <form asp-action="Branding" method="post" class="setup-form two-column">
                    @Html.AntiForgeryToken()
                    <div><label>English name</label><input class="input-shell" name="OrganizationNameEn" value="@Model.Draft.Branding.OrganizationNameEn" required /></div>
                    <div><label>الاسم العربي</label><input class="input-shell" name="OrganizationNameAr" value="@Model.Draft.Branding.OrganizationNameAr" required /></div>
                    <div><label>@t("Primary color", "اللون الأساسي")</label><input class="input-shell" name="PrimaryColor" value="@Model.Draft.Branding.PrimaryColor" /></div>
                    <div><label>@t("Time zone", "المنطقة الزمنية")</label><input class="input-shell" name="TimeZoneId" value="@Model.Draft.Branding.TimeZoneId" /></div>
                    <div class="setup-actions full"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Next", "التالي")</button></div>
                </form>
                break;

            case SetupStep.Security:
                <h2>@t("Security baseline", "إعدادات الأمان الأساسية")</h2>
                <form asp-action="Security" method="post" class="setup-form two-column">
                    @Html.AntiForgeryToken()
                    <div><label>@t("Session timeout (minutes)", "مهلة الجلسة بالدقائق")</label><input class="input-shell" type="number" min="5" max="1440" name="SessionTimeoutMinutes" value="@Model.Draft.Security.SessionTimeoutMinutes" /></div>
                    <div><label>@t("Lockout duration (minutes)", "مدة قفل الحساب بالدقائق")</label><input class="input-shell" type="number" min="1" max="1440" name="LockoutMinutes" value="@Model.Draft.Security.LockoutMinutes" /></div>
                    <div><label>@t("Maximum failed attempts", "الحد الأقصى للمحاولات الفاشلة")</label><input class="input-shell" type="number" min="3" max="20" name="MaxFailedAccessAttempts" value="@Model.Draft.Security.MaxFailedAccessAttempts" /></div>
                    <label class="check-row"><input type="hidden" name="RequireMfaForPrivilegedAccounts" value="false" /><input type="checkbox" name="RequireMfaForPrivilegedAccounts" value="true" checked="@Model.Draft.Security.RequireMfaForPrivilegedAccounts" /> @t("Require MFA for privileged accounts", "إلزام MFA للحسابات ذات الصلاحيات")</label>
                    <div class="setup-actions full"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Next", "التالي")</button></div>
                </form>
                break;

            case SetupStep.Integration:
                <h2>@t("Integration environment", "بيئة التكامل")</h2>
                <p>@t("This step creates configuration defaults only. Every service keeps independent UAT/Production endpoint and AuthProfile values in its owning phase.", "هذه الخطوة تضبط الإعدادات الافتراضية فقط. تظل إعدادات UAT/Production وAuthProfile مستقلة لكل خدمة في مرحلتها.")</p>
                <form asp-action="Integration" method="post" class="setup-form two-column">
                    @Html.AntiForgeryToken()
                    <div><label>@t("Default environment", "البيئة الافتراضية")</label><select class="input-shell" name="DefaultEnvironment"><option value="UAT" selected="@(Model.Draft.Integration.DefaultEnvironment == "UAT")">UAT</option><option value="Production" selected="@(Model.Draft.Integration.DefaultEnvironment == "Production")">Production / Go Live</option></select></div>
                    <div><label>@t("HTTP timeout (seconds)", "مهلة HTTP بالثواني")</label><input class="input-shell" type="number" min="3" max="300" name="TimeoutSeconds" value="@Model.Draft.Integration.TimeoutSeconds" /></div>
                    <div class="full"><label>@t("Proxy URL (optional)", "Proxy URL (اختياري)")</label><input class="input-shell" name="ProxyUrl" value="@Model.Draft.Integration.ProxyUrl" /></div>
                    <label class="check-row"><input type="hidden" name="ValidateServerCertificate" value="false" /><input type="checkbox" name="ValidateServerCertificate" value="true" checked="@Model.Draft.Integration.ValidateServerCertificate" /> @t("Validate server certificates", "التحقق من شهادات الخوادم")</label>
                    <div class="full secret-placeholder"><strong>@t("MOJ service credentials", "اعتمادات خدمات وزارة العدل")</strong><span>@t("Secure placeholders only. Real Consumer Key/Secret/API keys are entered per Service + Environment later and never committed.", "Placeholders آمنة فقط. يتم إدخال Consumer Key/Secret/API key الحقيقية لكل خدمة وبيئة لاحقاً ولا تُحفظ في Git.")</span></div>
                    <div class="setup-actions full"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Next", "التالي")</button></div>
                </form>
                break;

            case SetupStep.Notifications:
                <h2>@t("Notifications (optional)", "الإشعارات (اختياري)")</h2>
                <form asp-action="Notifications" method="post" class="setup-form two-column">
                    @Html.AntiForgeryToken()
                    <label class="check-row full"><input type="hidden" name="Enabled" value="false" /><input type="checkbox" name="Enabled" value="true" checked="@Model.Draft.Notifications.Enabled" /> @t("Enable SMTP notifications", "تفعيل إشعارات SMTP")</label>
                    <div><label>SMTP Host</label><input class="input-shell" name="SmtpHost" value="@Model.Draft.Notifications.SmtpHost" /></div>
                    <div><label>SMTP Port</label><input class="input-shell" type="number" name="SmtpPort" value="@Model.Draft.Notifications.SmtpPort" /></div>
                    <div class="full"><label>@t("Sender address", "عنوان المرسل")</label><input class="input-shell" type="email" name="SenderAddress" value="@Model.Draft.Notifications.SenderAddress" /></div>
                    <div class="setup-actions full"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit">@t("Review", "مراجعة")</button></div>
                </form>
                break;

            case SetupStep.Review:
                <h2>@t("Review & health check", "المراجعة وفحص الجاهزية")</h2>
                <div class="review-grid">
                    <div><span>@t("Database", "قاعدة البيانات")</span><strong>@Model.Draft.Database.Server / @Model.Draft.Database.DatabaseName</strong><small>@(Model.Draft.DatabaseProvisioned ? "MIGRATED" : "NOT READY")</small></div>
                    <div><span>@t("Administrator", "مدير النظام")</span><strong>@Model.Draft.Administrator.Username</strong><small>@Model.Draft.Administrator.Email</small></div>
                    <div><span>@t("Organization", "الجهة")</span><strong>@Model.Draft.Branding.OrganizationNameEn</strong><small>@Model.Draft.Branding.OrganizationNameAr</small></div>
                    <div><span>@t("Integration", "التكامل")</span><strong>@Model.Draft.Integration.DefaultEnvironment</strong><small>@t("Per-service secrets remain isolated", "الأسرار مستقلة لكل خدمة")</small></div>
                    <div><span>@t("Security", "الأمان")</span><strong>MFA: @(Model.Draft.Security.RequireMfaForPrivilegedAccounts ? "REQUIRED" : "OPTIONAL")</strong><small>Session @Model.Draft.Security.SessionTimeoutMinutes min</small></div>
                </div>
                <div class="setup-message warning"><strong>@t("Finish is irreversible from the public wizard", "Finish يقفل معالج الإعداد العام")</strong><span>@t("After success, setup routes are locked and the application proceeds to the Login shell. Identity activation belongs to P03.", "بعد النجاح يتم قفل مسارات الإعداد والانتقال إلى شاشة الدخول. تفعيل الهوية ضمن P03.")</span></div>
                <form asp-action="Finish" method="post">@Html.AntiForgeryToken()<div class="setup-actions"><a class="button-secondary" href="@Url.Action("Index", new { step = backStep, culture = Model.Culture })">@t("Back", "السابق")</a><button class="button-primary" type="submit" disabled="@(!Model.Draft.DatabaseProvisioned)">@t("Finish Setup", "إنهاء الإعداد")</button></div></form>
                break;

            case SetupStep.Finish:
                <h2>@t("Setup completed", "اكتمل الإعداد")</h2>
                <p>@t("The public setup wizard is now locked.", "تم الآن قفل معالج الإعداد العام.")</p>
                break;
        }
    </div>
</section>