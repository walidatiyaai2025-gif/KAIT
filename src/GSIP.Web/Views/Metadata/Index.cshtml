@using System.Globalization
@model GSIP.Web.Models.MetadataDashboardViewModel
@inject MetadataText M
@{
    ViewData["Title"] = M["PageTitle"];
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<section class="metadata-page">
    <header class="metadata-hero">
        <div><span class="metadata-kicker">P05 · @(isRtl ? "تعريفات قائمة على البيانات" : "Metadata-driven")</span><h1>@M["PageTitle"]</h1><p>@M["Subtitle"]</p></div>
        <div class="metadata-actions"><a class="metadata-button secondary" href="/metadata/schema">@M["Schema"]</a><a class="metadata-button" href="/metadata/export">@M["Export"]</a></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="metadata-alert error">@M["Error"]</div> }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="metadata-alert success">@M["Success"]</div> }

    <div class="metadata-stat-grid">
        <article><strong>@Model.Entities.Count</strong><span>@M["Entities"]</span></article>
        <article><strong>@Model.Services.Count</strong><span>@M["Services"]</span></article>
        <article><strong>@Model.Services.Sum(x => x.EnvironmentCount)</strong><span>@M["Environments"]</span></article>
        <article><strong>@Model.Services.Sum(x => x.FieldCount + x.MappingCount)</strong><span>@M["Fields"] / @M["Mappings"]</span></article>
    </div>

    <div class="metadata-grid">
        <section class="metadata-panel">
            <div class="panel-heading"><div><h2>@M["CreateEntity"]</h2><p>@M["Isolation"]</p></div></div>
            <form method="post" action="/metadata/entities" class="metadata-form">@Html.AntiForgeryToken()
                <label>@M["EntityCode"]<input name="code" maxlength="40" required /></label>
                <label>@M["ArabicName"]<input name="nameAr" maxlength="200" required dir="rtl" /></label>
                <label>@M["EnglishName"]<input name="nameEn" maxlength="200" required dir="ltr" /></label>
                <label>@M["Logo"]<input name="logo" maxlength="500" /></label>
                <label>@M["DisplayOrder"]<input name="displayOrder" type="number" value="10" /></label>
                <button class="metadata-button" type="submit">@M["Create"]</button>
            </form>
        </section>
        <section class="metadata-panel">
            <div class="panel-heading"><div><h2>@M["Import"]</h2><p>@M["ImportHelp"]</p></div></div>
            <form method="post" action="/metadata/import" class="metadata-form">@Html.AntiForgeryToken()
                <textarea name="metadataJson" rows="11" spellcheck="false" dir="ltr" placeholder="{ &quot;schemaVersion&quot;: 1, &quot;entities&quot;: [] }"></textarea>
                <button class="metadata-button" type="submit">@M["ImportAction"]</button>
            </form>
        </section>
    </div>

    <section class="metadata-catalog">
    @if (Model.Entities.Count == 0) { <div class="empty-state">@M["NoEntities"]</div> }
    @foreach (var entity in Model.Entities.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Code))
    {
        var services = Model.Services.Where(x => x.EntityId == entity.Id).OrderBy(x => x.Code).ToList();
        <article class="entity-card">
            <div class="entity-card-head"><div><div class="entity-code">@entity.Code</div><h2>@(isRtl ? entity.NameAr : entity.NameEn)</h2><span class="status-pill @(entity.Active ? "active" : "inactive")">@(entity.Active ? M["Active"] : M["Inactive"])</span></div><div class="entity-logo">@(string.IsNullOrWhiteSpace(entity.Logo) ? "◇" : "▣")</div></div>
            <details class="metadata-details"><summary>@M["Save"] · @M["Entities"]</summary>
                <form method="post" action="/metadata/entities/@entity.Id" class="metadata-form compact">@Html.AntiForgeryToken()
                    <label>@M["EntityCode"]<input name="code" value="@entity.Code" required /></label><label>@M["ArabicName"]<input name="nameAr" value="@entity.NameAr" dir="rtl" required /></label><label>@M["EnglishName"]<input name="nameEn" value="@entity.NameEn" dir="ltr" required /></label><label>@M["Logo"]<input name="logo" value="@entity.Logo" /></label><label>@M["DisplayOrder"]<input name="displayOrder" type="number" value="@entity.DisplayOrder" /></label><label class="checkbox"><input name="active" type="checkbox" value="true" checked="@entity.Active" /> @M["Active"]</label><button class="metadata-button" type="submit">@M["Save"]</button>
                </form>
            </details>
            <div class="service-list">
                @if (services.Count == 0) { <div class="empty-inline">@M["NoServices"]</div> }
                @foreach (var service in services)
                {
                    <article class="service-card">
                        <div class="service-summary"><div><span class="service-code">@service.Code</span><h3>@(isRtl ? service.NameAr : service.NameEn)</h3></div><div class="service-badges"><span>v@service.Version</span><span>@service.EnvironmentCount @M["Environments"]</span><span>@service.FieldCount @M["Fields"]</span><span>@service.MappingCount @M["Mappings"]</span></div></div>
                        <p class="history-note">@(service.WasUsed ? M["HistoricalProtection"] : M["NeverUsed"])</p>
                        <details class="metadata-details"><summary>@M["EditDefinition"]</summary><form method="post" action="/metadata/services/@service.Id" class="metadata-form">@Html.AntiForgeryToken()<textarea name="serviceJson" rows="18" spellcheck="false" dir="ltr">@service.DefinitionJson</textarea><button class="metadata-button" type="submit">@M["Save"]</button></form></details>
                        @if (service.Active) { <form method="post" action="/metadata/services/@service.Id/deactivate" class="inline-form">@Html.AntiForgeryToken()<button class="text-danger" type="submit">@M["Deactivate"]</button></form> }
                    </article>
                }
            </div>
            @if (entity.Active)
            {
                <details class="metadata-details create-service"><summary>＋ @M["CreateService"]</summary><form method="post" action="/metadata/entities/@entity.Id/services" class="metadata-form">@Html.AntiForgeryToken()<textarea name="serviceJson" rows="18" spellcheck="false" dir="ltr">@Model.ServiceTemplateJson</textarea><button class="metadata-button" type="submit">@M["Create"]</button></form></details>
            }
            @if (entity.Active && services.All(x => !x.Active)) { <form method="post" action="/metadata/entities/@entity.Id/deactivate" class="inline-form">@Html.AntiForgeryToken()<button class="text-danger" type="submit">@M["Deactivate"] @M["Entities"]</button></form> }
        </article>
    }
    </section>
</section>
